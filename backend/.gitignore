# ========================
# Nexus Backend - Python .gitignore
# ========================

# --- Environment Variables (CRITICAL) ---
.env
.env.*
*.env

# --- Python Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Virtual Environments ---
venv/
env/
.venv/
ENV/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- Distribution / Build ---
dist/
build/
*.egg-info/
*.egg

# --- Database Files ---
*.sqlite3
*.db

# --- Uploads (user-generated, shouldn't be in Git) ---
uploads/

# --- Verification / Temp Output ---
verification.txt
verification_output.txt
verification_utf8.txt

# --- One-off Utility Scripts (not part of the app) ---
test_*.py
verify_*.py
add_missing_keys.py
refactor_locales.py
replace_hardcoded.py
restore_keys.py

# --- OS ---
.DS_Store
Thumbs.db
